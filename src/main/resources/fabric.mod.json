{
	"schemaVersion": 1,
	"id": "blinddeafmute",
	"version": "${version}",
	"name": "BDM: Blind, Deaf, Mute",
	"description": "Server-controlled sensory roleplay for Fabric and Simple Voice Chat.",
	"authors": [
		"JustQuirk"
	],
	"contact": {
		"homepage": "https://github.com/paprocki-tymon/BDM-Blind-Deaf-Mute",
		"sources": "https://github.com/paprocki-tymon/BDM-Blind-Deaf-Mute"
	},
	"license": "CC0-1.0",
	"icon": "assets/blinddeafmute/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.blinddeafmute.BlindDeafMute"
		],
		"client": [
			"dev.blinddeafmute.client.BlindDeafMuteClient"
		],
		"voicechat": [
			"dev.blinddeafmute.voicechat.BlindDeafMuteVoicePlugin"
		]
	},
	"mixins": [
		{
			"config": "blinddeafmute.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.5",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": ">=0.134.1",
		"voicechat_api": ">=${voicechat_api_version}"
	}
}